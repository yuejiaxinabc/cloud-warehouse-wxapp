/* 全局样式 */
page {
  background: #f5f7fa;
  font-size: 28rpx;
  color: #1f2937;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
}

.btn-primary {
  background: #1677ff;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-primary[disabled] {
  background: #9cc4ff;
  color: #fff;
}

.btn-ghost {
  background: #fff;
  color: #1677ff;
  border: 2rpx solid #1677ff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 16rpx;
}

.muted { color: #8a94a6; font-size: 24rpx; }
.danger { color: #e5484d; }
.success { color: #16a34a; }
