<view class="page">
  <!-- 状态筛选 -->
  <view class="filter-row">
    <view class="chip {{statusFilter === '' ? 'active' : ''}}" bindtap="setStatus" data-s="">全部</view>
    <view class="chip {{statusFilter === 'PENDING' ? 'active' : ''}}" bindtap="setStatus" data-s="PENDING">待采购</view>
    <view class="chip {{statusFilter === 'PURCHASING' ? 'active' : ''}}" bindtap="setStatus" data-s="PURCHASING">已采购</view>
    <view class="chip {{statusFilter === 'COMPLETED' ? 'active' : ''}}" bindtap="setStatus" data-s="COMPLETED">采购完成</view>
  </view>

  <!-- 申请列表 -->
  <view wx:if="{{items.length === 0}}" class="empty muted">暂无购买申请，点右下角 + 新增</view>
  <view wx:for="{{items}}" wx:key="id" class="card pr-card">
    <view class="pr-head">
      <text class="pr-no">{{item.requestNo}}</text>
      <text class="pr-status st-{{item.status}}">{{item.statusText}}</text>
    </view>
    <view class="pr-name">{{item.name}} <text class="pr-qty">× {{item.quantity}}</text></view>
    <view class="muted" wx:if="{{item.model || item.color || item.size}}">
      {{item.model || ''}}{{item.color ? ' · ' + item.color : ''}}{{item.size ? ' · ' + item.size : ''}}
    </view>
    <view class="muted" wx:if="{{item.applicant}}">申请人：{{item.applicant}}</view>
    <view class="muted" wx:if="{{item.box}}">入库位置：{{item.box.code}}</view>

    <view class="pr-actions">
      <button wx:if="{{item.status === 'PENDING'}}" class="act-btn" size="mini" bindtap="markPurchased" data-id="{{item.id}}">已采购</button>
      <button wx:if="{{item.status === 'PURCHASING'}}" class="act-btn" size="mini" bindtap="markCompleted" data-id="{{item.id}}">采购完成</button>
      <button wx:if="{{item.status === 'COMPLETED' && !item.inboundOrderId}}" class="act-btn primary" size="mini" bindtap="openInbound" data-id="{{item.id}}">入库</button>
      <button wx:if="{{item.inboundOrderId}}" class="act-btn done" size="mini" disabled>已入库</button>
    </view>
  </view>

  <!-- 新增按钮 -->
  <view class="fab" bindtap="openCreate">＋</view>

  <!-- 新增申请弹层 -->
  <view wx:if="{{createOpen}}" class="mask" bindtap="closeCreate">
    <view class="sheet" catchtap="">
      <view class="sheet-title">新增备件购买申请</view>
      <view class="field">
        <text class="label">备件名称 *</text>
        <input class="input" placeholder="如：伺服电机" value="{{form.name}}" bindinput="onField" data-f="name" />
      </view>
      <view class="field-grid">
        <view class="field">
          <text class="label">型号</text>
          <input class="input" placeholder="如 SM-400F" value="{{form.model}}" bindinput="onField" data-f="model" />
        </view>
        <view class="field">
          <text class="label">颜色</text>
          <input class="input" placeholder="如 黑色" value="{{form.color}}" bindinput="onField" data-f="color" />
        </view>
        <view class="field">
          <text class="label">尺寸</text>
          <input class="input" placeholder="如 100×50mm" value="{{form.size}}" bindinput="onField" data-f="size" />
        </view>
        <view class="field">
          <text class="label">数量 *</text>
          <input class="input" type="number" value="{{form.quantity}}" bindinput="onField" data-f="quantity" />
        </view>
      </view>
      <view class="field">
        <text class="label">备注</text>
        <input class="input" placeholder="选填" value="{{form.remark}}" bindinput="onField" data-f="remark" />
      </view>
      <button class="btn-primary" loading="{{creating}}" bindtap="submitCreate">提交申请</button>
    </view>
  </view>

  <!-- 入库弹层 -->
  <view wx:if="{{inboundOpen}}" class="mask" bindtap="closeInbound">
    <view class="sheet" catchtap="">
      <view class="sheet-title">采购入库 — {{inboundTarget.requestNo}}</view>
      <view class="muted" style="margin-bottom: 20rpx;">{{inboundTarget.name}} × {{inboundTarget.quantity}}</view>

      <picker mode="selector" range="{{warehouses}}" range-key="name" bindchange="onWarehouseChange">
        <view class="picker {{form.warehouseId ? '' : 'placeholder'}}">
          <text class="p-label">仓库</text>{{warehouseName || '请选择仓库'}}
        </view>
      </picker>
      <picker mode="selector" range="{{locations}}" range-key="code" bindchange="onLocationChange" disabled="{{!form.warehouseId}}">
        <view class="picker {{form.locationId ? '' : 'placeholder'}}">
          <text class="p-label">货位</text>{{locationCode || '先选仓库'}}
        </view>
      </picker>
      <picker mode="selector" range="{{boxes}}" range-key="code" bindchange="onBoxChange" disabled="{{!form.locationId}}">
        <view class="picker {{form.boxId ? '' : 'placeholder'}}">
          <text class="p-label">盒子</text>{{boxCode || '先选货位'}}
        </view>
      </picker>
      <input class="input" type="digit" placeholder="单价（选填，用于成本核算）" value="{{unitCost}}" bindinput="onUnitCost" />

      <button class="btn-primary" loading="{{inbounding}}" bindtap="submitInbound">确认入库</button>
    </view>
  </view>
</view>
