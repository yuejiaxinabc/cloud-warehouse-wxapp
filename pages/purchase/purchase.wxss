.page { padding-bottom: 140rpx; }

.filter-row { display: flex; gap: 14rpx; padding: 20rpx 20rpx 0; }
.chip {
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 10rpx 28rpx;
  color: #64748b;
  border: 2rpx solid transparent;
}
.chip.active { background: #e6f0ff; color: #1677ff; border-color: #1677ff; font-weight: 600; }

.empty { text-align: center; padding: 120rpx 0; }

.pr-card { border-left: 6rpx solid #f59e0b; }
.pr-card:has(.st-PURCHASING) { border-left-color: #1677ff; }
.pr-head { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.pr-no { font-size: 26rpx; font-weight: 600; color: #475569; }
.pr-status { font-size: 24rpx; font-weight: 600; }
.st-PENDING { color: #e6890f; }
.st-PURCHASING { color: #1677ff; }
.st-COMPLETED { color: #16a34a; }
.pr-name { font-size: 32rpx; font-weight: 700; margin-bottom: 6rpx; }
.pr-qty { color: #1677ff; }
.pr-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eef2f7;
}
.act-btn {
  margin: 0;
  font-size: 24rpx;
  background: #f1f5f9;
  color: #334155;
  border-radius: 10rpx;
}
.act-btn.primary { background: #1677ff; color: #fff; }
.act-btn.done { background: #e7f7ee; color: #16a34a; }

.fab {
  position: fixed;
  right: 40rpx; bottom: 60rpx;
  width: 108rpx; height: 108rpx;
  background: linear-gradient(135deg, #1677ff, #4a94ff);
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 100rpx;
  font-size: 60rpx;
  font-weight: 300;
  box-shadow: 0 12rpx 30rpx rgba(22,119,255,0.4);
  z-index: 20;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.sheet-title { font-size: 32rpx; font-weight: 700; margin-bottom: 24rpx; text-align: center; }
.field { margin-bottom: 20rpx; }
.field-grid { display: flex; flex-wrap: wrap; gap: 0 20rpx; }
.field-grid .field { width: calc(50% - 10rpx); box-sizing: border-box; }
.label { display: block; font-size: 24rpx; color: #475569; margin-bottom: 8rpx; }
.input { background: #f5f7fa; border-radius: 12rpx; padding: 18rpx 24rpx; font-size: 28rpx; }

.picker {
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.picker.placeholder { color: #8a94a6; }
.p-label {
  background: #dfe9f5;
  color: #1677ff;
  font-size: 22rpx;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  margin-right: 16rpx;
}
