.page { padding-bottom: 30rpx; }

/* 看板 */
.dash {
  background: linear-gradient(160deg, #1677ff, #4a94ff);
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx 24rpx 22rpx;
  color: #fff;
}
.stat-row { display: flex; }
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 40rpx; font-weight: 700; }
.stat-label { font-size: 22rpx; opacity: 0.85; margin-top: 6rpx; }
.pending-row { display: flex; gap: 12rpx; margin-top: 24rpx; flex-wrap: wrap; }
.pending-item {
  background: rgba(255,255,255,0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}
.pending-item.ok { background: rgba(255,255,255,0.14); }

.quick-row { display: flex; gap: 16rpx; margin-top: 26rpx; }
.quick-btn {
  flex: 1;
  background: rgba(255,255,255,0.16);
  border: 1rpx solid rgba(255,255,255,0.25);
  border-radius: 16rpx;
  padding: 18rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
}
.q-icon { font-size: 36rpx; }

/* 趋势 */
.trend-legend { display: flex; gap: 24rpx; margin-bottom: 12rpx; }
.lg { font-size: 22rpx; color: #64748b; display: flex; align-items: center; gap: 8rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; display: inline-block; }
.dot.in { background: #16a34a; }
.dot.out { background: #e5484d; }
.dot.tr { background: #f59e0b; }
.trend { display: flex; align-items: flex-end; gap: 8rpx; }
.trend-col { flex: 1; text-align: center; }
.bars {
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
}
.bar { width: 16rpx; border-radius: 6rpx 6rpx 0 0; }
.bar.in { background: #16a34a; }
.bar.out { background: #e5484d; }
.bar.tr { background: #f59e0b; }
.trend-date { font-size: 20rpx; color: #8a94a6; margin-top: 8rpx; }

/* 仓库分布 */
.wh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}
.wh-row:last-child { border-bottom: none; }
.wh-name { font-size: 28rpx; font-weight: 500; }
.wh-value { color: #1677ff; font-weight: 600; font-size: 26rpx; }

/* 顶部搜索 */
.top-search {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 26rpx;
}
.ts-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  box-shadow: 0 6rpx 18rpx rgba(10, 40, 90, 0.15);
}
.ts-icon { font-size: 26rpx; margin-right: 12rpx; }
.ts-input { flex: 1; font-size: 28rpx; height: 72rpx; }
.ts-ph { color: #9aa7b8; }
.ts-scan { font-size: 34rpx; padding: 10rpx 6rpx 10rpx 16rpx; border-left: 1rpx solid #eef2f7; }
.ts-btn {
  margin: 0;
  background: rgba(255,255,255,0.22);
  border: 1rpx solid rgba(255,255,255,0.4);
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 查询结果头 */
.result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 4rpx;
}

.empty { text-align: center; padding: 60rpx 0; }

.item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.item-name { font-size: 32rpx; font-weight: 600; }
.stock-num { font-size: 40rpx; font-weight: 700; color: #1677ff; }
.item-meta { margin-top: 6rpx; }

.wh-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.wh-tag {
  background: #f0f5ff;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #334155;
}
.wh-qty { color: #1677ff; font-weight: 600; margin-left: 8rpx; }

.lot-list { margin-top: 16rpx; }
.lot-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}
.lot-no { color: #b45309; font-weight: 500; }
