<view class="page">
  <view class="card user-card">
    <view class="avatar">{{user.realName ? user.realName[0] : '仓'}}</view>
    <view class="user-info">
      <view class="user-name">{{user.realName || '未登录'}}</view>
      <view class="muted">{{user.username || ''}}</view>
      <view wx:if="{{user.roles && user.roles.length > 0}}" class="role-tags">
        <text wx:for="{{user.roles}}" wx:key="*this" class="role-tag">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="menu-item" bindtap="relogin">
      <text>切换账号</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleLogout">
      <text class="danger">退出登录</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer muted">云仓智能仓储管理平台 · v1.2.0</view>
</view>
