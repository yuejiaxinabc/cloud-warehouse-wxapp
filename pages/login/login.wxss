.login-wrap {
  min-height: 100vh;
  background: linear-gradient(160deg, #1677ff 0%, #3d8bff 45%, #6fb1ff 100%);
  padding: 0 48rpx;
  box-sizing: border-box;
}

.hero {
  text-align: center;
  padding: 130rpx 0 70rpx;
  color: #fff;
}
.logo-icon {
  width: 132rpx; height: 132rpx;
  margin: 0 auto 26rpx;
  background: rgba(255,255,255,0.22);
  border: 2rpx solid rgba(255,255,255,0.35);
  border-radius: 32rpx;
  font-size: 64rpx; font-weight: 700;
  line-height: 132rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 40, 100, 0.18);
}
.logo-title { font-size: 34rpx; font-weight: 700; letter-spacing: 2rpx; }
.logo-sub { font-size: 24rpx; opacity: 0.9; margin-top: 10rpx; letter-spacing: 2rpx; }

.form-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 52rpx 40rpx 44rpx;
  box-shadow: 0 16rpx 48rpx rgba(10, 40, 90, 0.18);
}
.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 36rpx;
  text-align: center;
}

.field { margin-bottom: 32rpx; }
.input-row {
  display: flex;
  align-items: center;
  background: #f4f6fa;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}
.input-row:focus-within { box-shadow: 0 0 0 3rpx rgba(22,119,255,0.25); }
.icon { font-size: 30rpx; margin-right: 16rpx; }
.input { flex: 1; font-size: 30rpx; height: 88rpx; }
.eye { font-size: 32rpx; padding: 10rpx; }

.login-btn {
  margin-top: 16rpx;
  background: linear-gradient(90deg, #1677ff, #3d8bff);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
  box-shadow: 0 10rpx 24rpx rgba(22,119,255,0.35);
}
.login-btn[disabled] { background: #9cc4ff; color: #fff; }

.footer { text-align: center; margin-top: 48rpx; }
